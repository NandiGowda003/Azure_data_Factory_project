			"defaultValue": "gowda"
		},
		"ls_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfnandistorage.dfs.core.windows.net/"
		},
		"ls_github_properties_typeProperties_url": {
